MONGO_URI=mongodb+srv://usuario:password@cluster.mongodb.net/tramitador
JWT_SECRET=cambiar-en-produccion
JWT_EXPIRES_IN=2h
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Opción A: SMTP cPanel (recomendado)
MAIL_PROVIDER=smtp
MAIL_FROM=Tramitador Exhorto <no-reply@tramitadorexhorto.cl>
SMTP_HOST=mail.tramitadorexhorto.cl
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@tramitadorexhorto.cl
# Usa comillas si la contraseña tiene # $ ! u otros caracteres especiales
SMTP_PASSWORD="contraseña-del-correo"

# Opción B: Resend (requiere verificar dominio)
# MAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxx
# MAIL_FROM=Tramitador Exhorto <no-reply@tramitadorexhorto.cl>
