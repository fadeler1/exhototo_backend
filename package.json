{
  "name": "exhorto-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0 <21"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest build && nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:smtp": "node scripts/test-smtp.mjs",
    "seed:users": "nest build && node dist/database/seeds/seed-users.js",
    "seed:users:force": "nest build && node dist/database/seeds/seed-users.js --force",
    "seed:diligencia-tipos": "nest build && node dist/database/seeds/seed-diligencia-tipos.js",
    "migrate:mysql": "nest build && node dist/database/migration/run-migration.js",
    "migrate:mysql:dry": "nest build && node dist/database/migration/run-migration.js --dry-run",
    "migrate:mysql:full": "nest build && node dist/database/migration/run-migration.js --clear --users",
    "migrate:csv": "nest build && node dist/database/migration/run-migration-csv.js",
    "migrate:csv:dry": "nest build && node dist/database/migration/run-migration-csv.js --dry-run",
    "migrate:sql": "nest build && node dist/database/migration/run-migration-sql.js",
    "migrate:sql:dry": "nest build && node dist/database/migration/run-migration-sql.js --dry-run",
    "migrate:sql:sequential": "nest build && node dist/database/migration/run-migration-sql.js --sequential",
    "migrate:sql:sequential:dry": "nest build && node dist/database/migration/run-migration-sql.js --sequential --dry-run",
    "migrate:sql:bundle": "nest build && node dist/database/migration/run-migration-sql.js --sequential --bundle=ctr17658_EXHORTO.sql",
    "migrate:sql:bundle:dry": "nest build && node dist/database/migration/run-migration-sql.js --sequential --dry-run --bundle=ctr17658_EXHORTO.sql",
    "migrate:sql:bundle:full": "nest build && node dist/database/migration/run-migration-sql.js --sequential --clear --users --bundle=ctr17658_EXHORTO.sql",
    "migrate:sql:downloads": "nest build && node dist/database/migration/run-migration-sql.js --dir=/Users/pablomagnere/Downloads"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.21",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.21",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.21",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "csv-parse": "^6.2.1",
    "mongoose": "^9.6.2",
    "mysql2": "^3.22.3",
    "nodemailer": "^8.0.10",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "@nestjs/cli": "^11.0.21",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.21",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.41",
    "@types/nodemailer": "^8.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.6.0",
    "jest": "^30.4.2",
    "prettier": "^3.8.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-loader": "^9.5.7",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
